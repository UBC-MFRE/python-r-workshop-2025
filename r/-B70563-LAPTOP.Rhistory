#factorial
factorail_func <- function(num){
result <- 1
for(i in 1:num){
result <- result * i
}
return(result)
}
n <- as.numeric(readline(prompt = "enter a number: "))
print(paste("Factorial of", n, "is", factorail_func(n)))
