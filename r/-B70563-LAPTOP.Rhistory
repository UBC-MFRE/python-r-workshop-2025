n <- as.integer(readline(prompt = "Enter the upper limit: "))
sum_val <- 0L
print(paste("Start with sum =", sum_val))
for (i in 1:n) {
if (i %% 2 == 1) {
new_sum <- sum_val + i
print(sprintf("%d + %d = %d", sum_val, i, new_sum))
} else {
new_sum <- sum_val * i
print(sprintf("%d * %d = %d", sum_val, i, new_sum))
}
sum_val <- new_sum
}
print(paste("Final result:", sum_val))
