plot(number_range_b, number_range_c)
plot(number_range_c, number_range_a)
lm_a_b <- lm(number_range_a ~ number_range_b)
summary(lm_a_b)
lm_b_c <- lm(number_range_b ~ number_range_c)
summary(lm_b_c)
lm_c_a <- lm(number_range_c ~ number_range_a)
summary(lm_c_a)
